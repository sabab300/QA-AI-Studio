/******************************************************************************
 QA AI Studio
 Enterprise Theme v1.0
 Inspired by Pakistan Single Window (PSW)

 Author : QA AI Studio
******************************************************************************/

/* ==========================================================================
   GLOBAL
   ========================================================================== */

*{
    font-family: "Segoe UI";
    font-size: 10pt;
    outline: none;
}


/* ==========================================================================
   MAIN WINDOW
   ========================================================================== */

QMainWindow{

    background:#F4F7FB;

}


/* ==========================================================================
   CENTRAL AREA
   ========================================================================== */

QWidget#CentralWidget{

    background:#F4F7FB;

}


/* ==========================================================================
   TOP BAR
   ========================================================================== */

QFrame#TopBar{

    background:#0C4DA2;

    border:none;

    min-height:64px;

    max-height:64px;

}


QLabel#AppTitle{

    color:white;

    font-size:18pt;

    font-weight:bold;

}


QLabel#AppSubtitle{

    color:white;

    font-size:9pt;

}


/* ==========================================================================
   LEFT MENU
   ========================================================================== */

QFrame#SideMenu{

    background:white;

    border-right:1px solid #D9DDE4;

    min-width:240px;

    max-width:240px;

}


/* ==========================================================================
   MENU BUTTONS
   ========================================================================== */

QPushButton#MenuButton{

    background:transparent;

    border:none;

    color:#23313F;

    text-align:left;

    padding-left:18px;

    height:42px;

    font-size:11pt;

}


QPushButton#MenuButton:hover{

    background:#EAF3FF;

    color:#0C4DA2;

}


QPushButton#MenuButton:checked{

    background:#D6E9FF;

    color:#0C4DA2;

    font-weight:bold;

}


/* ==========================================================================
   PAGE AREA
   ========================================================================== */

QFrame#ContentArea{

    background:#F4F7FB;

}


/* ==========================================================================
   PAGE TITLE
   ========================================================================== */

QLabel#PageTitle{

    font-size:18pt;

    font-weight:bold;

    color:#23313F;

}


QLabel#SectionTitle{

    font-size:12pt;

    font-weight:bold;

    color:#0C4DA2;

}


/* ==========================================================================
   CARDS
   ========================================================================== */

QFrame#Card{

    background:white;

    border:1px solid #D9DDE4;

    border-radius:10px;

}


QFrame#Card:hover{

    border:1px solid #0C4DA2;

}


/* ==========================================================================
   BUTTONS
   ========================================================================== */

QPushButton{

    background:#0C4DA2;

    color:white;

    border:none;

    border-radius:6px;

    min-height:36px;

    padding-left:18px;

    padding-right:18px;

}


QPushButton:hover{

    background:#145FC1;

}


QPushButton:pressed{

    background:#09397A;

}


QPushButton:disabled{

    background:#B9C7DB;

    color:white;

}


/* ==========================================================================
   SUCCESS BUTTON
   ========================================================================== */

QPushButton#SuccessButton{

    background:#2E8B57;

}


QPushButton#SuccessButton:hover{

    background:#38A567;

}


/* ==========================================================================
   WARNING BUTTON
   ========================================================================== */

QPushButton#WarningButton{

    background:#E68A00;

}


QPushButton#WarningButton:hover{

    background:#F49C15;

}


/* ==========================================================================
   DANGER BUTTON
   ========================================================================== */

QPushButton#DangerButton{

    background:#D9534F;

}


QPushButton#DangerButton:hover{

    background:#E76561;

}


/* ==========================================================================
   INPUTS
   ========================================================================== */

QLineEdit,
QPlainTextEdit,
QTextEdit,
QComboBox,
QSpinBox{

    background:white;

    border:1px solid #D5D9E0;

    border-radius:6px;

    min-height:34px;

    padding-left:8px;

}


QLineEdit:focus,
QPlainTextEdit:focus,
QTextEdit:focus,
QComboBox:focus{

    border:1px solid #0C4DA2;

}


/* ==========================================================================
   TREE
   ========================================================================== */

QTreeWidget{

    background:white;

    border:1px solid #D5D9E0;

    border-radius:6px;

}


QTreeWidget::item{

    height:30px;

}


QTreeWidget::item:selected{

    background:#D6E9FF;

    color:#23313F;

}


/* ==========================================================================
   TABLE
   ========================================================================== */

QTableWidget{

    background:white;

    border:1px solid #D5D9E0;

    gridline-color:#E8EDF3;

}


QHeaderView::section{

    background:#EEF3FA;

    border:none;

    border-bottom:1px solid #D5D9E0;

    height:32px;

    font-weight:bold;

}


/* ==========================================================================
   STATUS BAR
   ========================================================================== */

QStatusBar{

    background:white;

    border-top:1px solid #D5D9E0;

}


/* ==========================================================================
   SPLITTER
   ========================================================================== */

QSplitter::handle{

    background:#E2E6ED;

}


/* ==========================================================================
   SCROLLBAR
   ========================================================================== */

QScrollBar:vertical{

    background:#EEF2F7;

    width:12px;

}


QScrollBar::handle:vertical{

    background:#BFC9D7;

    border-radius:5px;

}


QScrollBar::handle:vertical:hover{

    background:#9EABBD;

}


QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical{

    height:0;

}


QScrollBar:horizontal{

    background:#EEF2F7;

    height:12px;

}


QScrollBar::handle:horizontal{

    background:#BFC9D7;

    border-radius:5px;

}


QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal{

    width:0;

}

/* ===== Enterprise AI Compact UI v2 ===== */
/* Dense light workspace + dark AI navigation. Visual-only rules: no signals,
   models, repositories, or business behavior are changed here. */
*{font-family:"Segoe UI";font-size:9pt;}
QMainWindow,QWidget#CentralWidget,QFrame#ContentArea{background:#F8FAFC;color:#0F172A;}
QFrame#TopBar{background:#FFFFFF;border-bottom:1px solid #E2E8F0;min-height:52px;max-height:52px;}
QLabel#AppTitle{color:#0F172A;font-size:15pt;font-weight:700;}
QLabel#AppSubtitle{color:#64748B;font-size:8pt;}
QFrame#SideMenu{background:#0F172A;border-right:1px solid #1E293B;min-width:218px;max-width:218px;}
QPushButton#MenuButton{background:transparent;border:none;color:#CBD5E1;text-align:left;padding:0 12px;height:36px;min-height:36px;max-height:36px;font-size:9.5pt;border-radius:6px;}
QPushButton#MenuButton:hover{background:#1E293B;color:#FFFFFF;}
QPushButton#MenuButton:checked{background:#312E81;color:#FFFFFF;font-weight:600;border-left:3px solid #38BDF8;}
QLabel#PageTitle{font-size:16pt;font-weight:700;color:#0F172A;}
QLabel#SectionTitle{font-size:10pt;font-weight:700;color:#0F172A;}
QFrame#DesktopTabStrip,QFrame#QaAutomationTabStrip{background:#FFFFFF;border-bottom:1px solid #E2E8F0;}
QPushButton#DesktopTabButton{background:transparent;color:#64748B;border:none;border-bottom:2px solid transparent;border-radius:0;padding:7px 2px;min-height:30px;font-weight:600;}
QPushButton#DesktopTabButton:hover{color:#0F172A;}
QPushButton#DesktopTabButton:checked{color:#4F46E5;border-bottom:2px solid #4F46E5;}
QFrame#Card{background:#FFFFFF;border:1px solid #E2E8F0;border-radius:8px;}
QPushButton{min-height:30px;padding:4px 10px;border-radius:6px;}
QLineEdit,QComboBox,QDateEdit,QSpinBox,QDoubleSpinBox{min-height:30px;max-height:34px;padding:2px 8px;border:1px solid #CBD5E1;border-radius:6px;background:#FFFFFF;color:#0F172A;}
QTextEdit,QPlainTextEdit{border:1px solid #CBD5E1;border-radius:6px;background:#FFFFFF;color:#0F172A;}
QTableWidget,QTableView,QTreeWidget{background:#FFFFFF;border:1px solid #E2E8F0;gridline-color:#E2E8F0;alternate-background-color:#F8FAFC;}
QHeaderView::section{background:#F1F5F9;color:#475569;border:none;border-bottom:1px solid #E2E8F0;padding:6px 7px;font-size:8.5pt;font-weight:600;}
QTableWidget::item,QTableView::item{padding:4px 6px;}
QScrollBar:vertical{width:10px;} QScrollBar:horizontal{height:10px;}
QStatusBar{min-height:24px;max-height:26px;background:#FFFFFF;border-top:1px solid #E2E8F0;}
